# Jenkins local (controlador). Copiar a secrets.env (gitignored) y completar.

# Admin del Jenkins local
JENKINS_ADMIN_ID=
JENKINS_ADMIN_PASSWORD=

# GitHub (compartida) -> github-creds
GITHUB_USER=
GITHUB_TOKEN=

# ---------- cuenta: alejandro ----------
# hwc-alejandro (AK/SK, sirve para provider y backend del state)
HWC_ALEJANDRO_AK=
HWC_ALEJANDRO_SK=
# swr-alejandro
SWR_ALEJANDRO_USER=
SWR_ALEJANDRO_PASSWORD=

# ---------- cuenta: aiops ----------
# hwc-aiops / swr-aiops (vacias hasta tener las credenciales)
HWC_AIOPS_AK=
HWC_AIOPS_SK=
SWR_AIOPS_USER=
SWR_AIOPS_PASSWORD=
